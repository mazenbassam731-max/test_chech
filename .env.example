# --- Anthropic (Claude) API ---
# Used to read each post and extract: area/project mentioned, property type,
# deal type (sale/rent), and to compare against the group's config.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Google Sheets ---
# The spreadsheet ID is the long string in your sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Path to the Google service-account JSON key file (see README setup steps).
GOOGLE_SERVICE_ACCOUNT_FILE=./config/service-account.json

# --- WhatsApp / behavior ---
# Your own number in international format, no +, no spaces (e.g. 971501234567).
# This is used to find your "Message Yourself" chat.
OWNER_WHATSAPP_NUMBER=971501234567

# How many identical/near-identical messages from the same sender within this
# window (minutes) counts as spam.
SPAM_REPEAT_WINDOW_MINUTES=15

# Where Baileys stores its login session (so you don't rescan the QR every restart).
AUTH_STATE_DIR=./data/auth
